# Rename this file to .gitignore

# Gradle
.gradle/
# Depth-agnostic on purpose -- every module has its own output directory, not just the root.
# The cost is that it also matches a *Kotlin package* called `build`, which is not output at all;
# `buildSrc`'s own task types live in one. That cost was paid once already: the package was
# silently never committed, every local build kept working because the files were still on disk,
# and the repository only turned out to be unbuildable when CI cloned it fresh. The re-include
# below is what keeps that from happening again. It works because only the `build` directory
# itself is excluded here -- git cannot re-include a file whose *parent* directory is excluded,
# and `src/main/kotlin/app/ageha/` is not.
build/
!*/src/**/build/
# Kotlin 2.x's build-tools session directory. Local scratch, regenerated every build.
.kotlin/
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties
local.properties

# IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# OS
.DS_Store
Thumbs.db

# Upstream repos cloned for reference — never commit these
reference/

# Build output / packaging
output/
*.msi
*.dmg
*.deb
*.AppImage
conveyor.key

# Downloaded parser JARs cached during development
parsers-cache/

# Secrets
.env
*.p12
*.jks
signing.properties

# Skills installed by `npx skills add`
.agents/

# Scratch copies kept while reworking a file. Never part of the project.
.tmpwork/

# Skills installed by `npx skills add` land here as symlinks into .agents/.
# skills-lock.json is committed so the set is reproducible; the content is not ours to vendor.
.claude/skills/
